# /etc/labit-heartbeat.env  -- chmod 600, owner labit-heartbeat. Contains the node token: NEVER commit a real one.
# OPTIONAL FALLBACK, disabled by default. Primary monitoring = public.cto_service_latest collectors.
HEARTBEAT_ENABLED=0
NODE_ID=devserver
HEARTBEAT_TOKEN=REPLACE_WITH_TOKEN_FROM_gen-token.sh
#PANEL_URL=CHANGE-ME  (heartbeat is DISABLED by default; panel-api is localhost-only, exposure needs a separate decision)
#CHECKS_FILE=/etc/labit-heartbeat.checks
