# Limited Postgres role created by panel/db/002_labit_ops_role.sql (NOT the Supabase service-role key)
PANEL_DB_DSN=postgresql://labit_ops_api:CHANGE-ME@10.0.0.2:5433/postgres?sslmode=prefer
# Shared secret the labit-main route handler sends as X-Panel-Key. Unset => every endpoint except /health is 401.
PANEL_INTERNAL_KEY=CHANGE-ME
# optional: restrict CTO rows to one lab (cto_service_latest.lab_id)
PANEL_LAB_ID=
STALE_SECONDS=180
POLL_INTERVAL=60
# Optional push fallback for nodes NOT covered by cto_service_latest. Off => POST /heartbeat returns 404.
HEARTBEAT_ENABLED=0
ENABLE_BACKGROUND=1
SNAPSHOT_TTL=5
